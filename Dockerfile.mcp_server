# syntax=docker/dockerfile:1
# Standalone RyanAI MCP HTTP service. Build from the repository root:
# docker build -f Dockerfile.mcp_server -t ryanai-mcp .
FROM node:24-alpine AS runtime
LABEL org.opencontainers.image.title="RyanAI MCP Server" \
      org.opencontainers.image.description="Delegated, allowlisted RyanAI MCP HTTP service"

ENV NODE_ENV=production \
    MCP_HOST=0.0.0.0 \
    MCP_PORT=8765 \
    PUPPETEER_SKIP_DOWNLOAD=true

WORKDIR /app/mcp-server

# Keep the runtime small and patched; the lockfile is the dependency source of truth.
RUN apk upgrade --no-cache \
    && apk add --no-cache 'libexpat>=2.10.0-r0'

COPY mcp-server/package.json mcp-server/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund \
    && npm cache clean --force \
    && rm -rf /usr/local/lib/node_modules/npm \
    && rm -f /usr/local/bin/npm /usr/local/bin/npx

COPY mcp-server/index.js mcp-server/http.js mcp-server/provider-router.js mcp-server/stdio.js mcp-server/health-url.js mcp-server/tool-registry.js mcp-server/delegation.js ./
COPY stacks/ryanai.stack.json /app/stacks/ryanai.stack.json

RUN node --check index.js \
    && node --check http.js \
    && node --check provider-router.js \
    && node --check stdio.js \
    && node --check health-url.js \
    && node --check tool-registry.js \
    && node --check delegation.js \
    && chown -R node:node /app

USER node
EXPOSE 8765
HEALTHCHECK --interval=20s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||process.env.MCP_PORT||8765)+'/health',{signal:AbortSignal.timeout(4000)}).then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "http.js"]
