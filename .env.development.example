# RyanAI local development overlay.
# Source of truth: https://github.com/ganyanentsiyeni-rgb/RYANAI-Automous-Reasioning-Plat-main (main).
# Overlay on .env.example; copy only into ignored local .env. Never commit populated .env files.
# Secrets stay local/private. Reports may show key names and configured/missing status, never values.
HOST=127.0.0.1
PORT=3001
VITE_APP_ENV=development
VITE_API_BASE_URL=
CORS_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,http://localhost:9090,http://127.0.0.1:9090
SCHEDULER_ENABLED=false
ALERTS_ENABLED=false
COMMUNICATIONS_ENABLED=false
COMMUNICATION_ATTACHMENTS_ENABLED=false
ATTACHMENT_SCANNER_ENABLED=false
ATTACHMENT_ORPHAN_CLEANUP_ENABLED=false
