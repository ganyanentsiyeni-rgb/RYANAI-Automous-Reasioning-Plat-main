# RyanAI frontend-only environment template.
# Copy values into the local ignored .env file or configure them in the hosting
# provider's frontend build environment. Never put server credentials here.
#
# API port contract:
# - Local Vite development proxies to http://127.0.0.1:3001 by default.
# - Docker Compose API listens on port 3000 inside the container.
# - Hosted U2EB/Production builds must use the matching HTTPS API origin.

VITE_APP_ENV=development
VITE_API_BASE_URL=
# Optional compatibility alias; prefer VITE_API_BASE_URL.
VITE_API_URL=
# Optional legacy API origin; prefer VITE_API_BASE_URL.
VITE_API_URL=

# Public Supabase client configuration only.
# Use the project URL and publishable key belonging to the SAME environment.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy compatibility only; prefer VITE_SUPABASE_PUBLISHABLE_KEY.
VITE_SUPABASE_ANON_KEY=

# Optional public websocket origin; leave blank to derive it from VITE_API_BASE_URL.
VITE_WS_URL=
VITE_PORT=1420

# Optional public websocket origin; leave blank to derive it from VITE_API_BASE_URL.
VITE_WS_URL=
VITE_PORT=1420
