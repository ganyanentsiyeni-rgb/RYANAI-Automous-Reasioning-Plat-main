  metadata       Json            @default("{}")
  capturedAt     DateTime        @default(now()) @map("captured_at") @db.Timestamptz(6)
  scan           SecurityScan    @relation(fields: [scanId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  finding        SecurityFinding? @relation(fields: [findingId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([scanId, capturedAt(sort: Desc)], map: "security_evidence_scan_captured_idx")
  @@index([findingId, capturedAt(sort: Desc)], map: "security_evidence_finding_captured_idx")
  @@map("security_evidence")
  @@schema("public")
}

model SecurityRemediation {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  findingId          String           @map("finding_id") @db.Uuid
  recommendation     String           @db.Text
  rationale          String?          @db.Text
  status             String           @default("proposed")
  proposedBy         String           @map("proposed_by")
  reviewedBy         String?          @map("reviewed_by")
  reviewedAt         DateTime?        @map("reviewed_at") @db.Timestamptz(6)
