// Security Centre records. Operational audit events continue to use JarvisAuditEvent;
// engineering execution evidence continues to use AgentRunEvidence.
model SecurityScan {
  id               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerUserId      String?               @map("owner_user_id") @db.Uuid
  initiatedBy      String                @map("initiated_by")
  source           String
  environment      String
  targetRef        String?               @map("target_ref")
  branch           String?
  commitSha        String?               @map("commit_sha")
  workflowRunId    String?               @map("workflow_run_id")
  status           String                @default("queued")
  toolchain        Json                  @default("{}")
  summary          Json                  @default("{}")
  approvalId       String?               @map("approval_id") @db.Uuid
  startedAt        DateTime?             @map("started_at") @db.Timestamptz(6)
  completedAt      DateTime?             @map("completed_at") @db.Timestamptz(6)
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  approval         SecurityApproval?     @relation(fields: [approvalId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  findings         SecurityFinding[]
  evidence         SecurityEvidence[]
  verifiedRemediations SecurityRemediation[] @relation("SecurityRemediationVerification")

  @@index([createdAt(sort: Desc)], map: "security_scans_created_idx")
  @@index([commitSha, createdAt(sort: Desc)], map: "security_scans_commit_created_idx")
  @@index([environment, status, createdAt(sort: Desc)], map: "security_scans_environment_status_idx")
  @@index([ownerUserId, createdAt(sort: Desc)], map: "security_scans_owner_created_idx")
  @@map("security_scans")
  @@schema("public")
}

model SecurityFinding {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scanId            String                @map("scan_id") @db.Uuid
  fingerprint       String
  sourceTool        String                @map("source_tool")
  ruleId            String?               @map("rule_id")
  severity          String
  confidence        String                @default("unknown")
  title             String
  description       String?               @db.Text
  affectedComponent String?               @map("affected_component")
  filePath          String?               @map("file_path")
  startLine         Int?                  @map("start_line")
  endLine           Int?                  @map("end_line")
  cve               String?
  cwe               String?
  cvss              Decimal?             @db.Decimal(4, 2)
  status            String                @default("open")
  firstSeenAt       DateTime              @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt        DateTime              @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  scan              SecurityScan          @relation(fields: [scanId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  evidence          SecurityEvidence[]
  remediations      SecurityRemediation[]

  @@unique([scanId, fingerprint])
  @@index([severity, status, lastSeenAt(sort: Desc)], map: "security_findings_severity_status_seen_idx")
  @@index([fingerprint, lastSeenAt(sort: Desc)], map: "security_findings_fingerprint_seen_idx")
  @@index([affectedComponent, status], map: "security_findings_component_status_idx")
  @@map("security_findings")
  @@schema("public")
}

model SecurityEvidence {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scanId         String          @map("scan_id") @db.Uuid
  findingId      String?         @map("finding_id") @db.Uuid
  evidenceType   String          @map("evidence_type")
