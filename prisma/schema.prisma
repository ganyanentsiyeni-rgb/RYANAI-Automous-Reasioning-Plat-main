  finding            SecurityFinding  @relation(fields: [findingId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  verificationScan   SecurityScan?    @relation("SecurityRemediationVerification", fields: [verificationScanId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([findingId, status, createdAt(sort: Desc)], map: "security_remediations_finding_status_idx")
  @@map("security_remediations")
  @@schema("public")
}

model SecurityApproval {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope       String
  environment String
  targetRef   String         @map("target_ref")
  commitSha   String?        @map("commit_sha")
  requestHash String         @map("request_hash")
  requestedBy String         @map("requested_by")
  decidedBy   String?        @map("decided_by")
  status      String         @default("pending")
  reason      String?        @db.Text
  expiresAt   DateTime       @map("expires_at") @db.Timestamptz(6)
  usedAt      DateTime?      @map("used_at") @db.Timestamptz(6)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  scans       SecurityScan[]

  @@index([status, expiresAt], map: "security_approvals_status_expiry_idx")
  @@index([targetRef, commitSha], map: "security_approvals_target_commit_idx")
  @@map("security_approvals")
  @@schema("public")
}

/// Server-only provider credentials. Token ciphertext is never exposed through
/// catalogue or user-facing profile APIs; access is owner-scoped in services.
model PluginProviderConnection {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerUserId           String    @map("owner_user_id")
  providerId            String    @map("provider_id") @db.VarChar(64)
  externalAccountId     String?   @map("external_account_id")
  displayLabel          String?   @map("display_label") @db.VarChar(255)
  status                String    @default("connected") @db.VarChar(32)
  encryptedAccessToken  String?   @map("encrypted_access_token") @db.Text
  encryptedRefreshToken String?   @map("encrypted_refresh_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  grantedScopes         String[]  @default([]) @map("granted_scopes")
  connectionMetadata    Json      @default("{}") @map("connection_metadata")
  connectedAt           DateTime? @map("connected_at") @db.Timestamptz(6)
  revokedAt             DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  authorizationEvents   PluginAuthorizationEvent[]

  @@unique([ownerUserId, providerId], map: "plugin_provider_connections_owner_provider_key")
  @@index([ownerUserId, status, updatedAt(sort: Desc)], map: "plugin_provider_connections_owner_status_idx")
  @@index([providerId, status, updatedAt(sort: Desc)], map: "plugin_provider_connections_provider_status_idx")
  @@map("plugin_provider_connections")
  @@schema("public")
}

/// Short-lived one-use OAuth state. The raw state is never persisted.
model PluginOAuthState {
  stateHash             String   @id @map("state_hash") @db.VarChar(64)
  ownerUserId           String   @map("owner_user_id")
  providerId            String   @map("provider_id") @db.VarChar(64)
  encryptedCodeVerifier String   @map("encrypted_code_verifier") @db.Text
  requestedScopes       String[] @map("requested_scopes")
  redirectUri           String   @map("redirect_uri") @db.Text
  expiresAt             DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([expiresAt], map: "plugin_oauth_states_expires_idx")
  @@index([ownerUserId, providerId], map: "plugin_oauth_states_owner_provider_idx")
  @@map("plugin_oauth_states")
  @@schema("public")
}

/// Append-only, redacted authorization lifecycle evidence. Never store tokens.
model PluginAuthorizationEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerUserId String   @map("owner_user_id")
  providerId  String   @map("provider_id") @db.VarChar(64)
  connectionId String? @map("connection_id") @db.Uuid
  connection PluginProviderConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "plugin_authorization_events_connection_id_fkey")
  eventType   String   @map("event_type") @db.VarChar(64)
  actorUserId String   @map("actor_user_id")
  requestId   String?  @map("request_id") @db.VarChar(128)
  details     Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([ownerUserId, createdAt(sort: Desc)], map: "plugin_authorization_events_owner_created_idx")
  @@index([connectionId, createdAt(sort: Desc)], map: "plugin_authorization_events_connection_created_idx")
  @@map("plugin_authorization_events")
  @@schema("public")
}


/// RyanAI Studio owns project identity and lifecycle independently of agent runs.
model StudioProject {
  id          String   @id @default(uuid())
  ownerUserId String   @map("owner_user_id")
  owner       User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  title       String   @db.VarChar(200)
  objective   String   @db.Text
  projectType String   @map("project_type") @db.VarChar(32)
  status      String   @default("draft") @db.VarChar(32)
  priority    Int      @default(0)
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  tasks       StudioTask[]
  artifacts   StudioArtifact[]
  events      StudioEvent[]

  @@index([ownerUserId, status, updatedAt(sort: Desc)], map: "studio_projects_owner_status_updated_idx")
  @@index([status, priority, createdAt], map: "studio_projects_status_priority_created_idx")
  @@map("studio_projects")
  @@schema("public")
}

/// Durable, dependency-aware Studio work item. Lease fields support competing workers safely.
model StudioTask {
  id                  String    @id @default(uuid())
  projectId           String    @map("project_id")
  project             StudioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ownerUserId         String    @map("owner_user_id")
  owner               User      @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  title               String    @db.VarChar(240)
  objective           String    @db.Text
  taskType            String    @map("task_type") @db.VarChar(48)
  status              String    @default("queued") @db.VarChar(32)
  priority            Int       @default(0)
  requiredCapabilities String[] @default([]) @map("required_capabilities")
  assignedWorkerId    String?   @map("assigned_worker_id") @db.VarChar(96)
  dependsOnIds        String[]  @default([]) @map("depends_on_ids")
  input               Json      @default("{}")
  output              Json?
  attempts            Int       @default(0)
  maxAttempts         Int       @default(3) @map("max_attempts")
  availableAt         DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  leaseOwner          String?   @map("lease_owner") @db.VarChar(128)
  leaseToken          String?   @map("lease_token") @db.Uuid
  leaseExpiresAt      DateTime? @map("lease_expires_at") @db.Timestamptz(6)
  heartbeatAt         DateTime? @map("heartbeat_at") @db.Timestamptz(6)
  approvalRequired    Boolean   @default(false) @map("approval_required")
  approvalStatus      String    @default("not_required") @map("approval_status") @db.VarChar(32)
  idempotencyKey      String?   @unique @map("idempotency_key") @db.VarChar(160)
  startedAt           DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt         DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  artifacts           StudioArtifact[]
  events              StudioEvent[]

  @@index([projectId, status, priority], map: "studio_tasks_project_status_priority_idx")
  @@index([status, availableAt, priority], map: "studio_tasks_claim_idx")
  @@index([leaseExpiresAt], map: "studio_tasks_lease_expiry_idx")
  @@index([ownerUserId, createdAt(sort: Desc)], map: "studio_tasks_owner_created_idx")
  @@map("studio_tasks")
  @@schema("public")
}

/// Metadata and provenance for files stored by an approved storage adapter.
model StudioArtifact {
  id          String   @id @default(uuid())
  projectId   String   @map("project_id")
  project     StudioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId      String?  @map("task_id")
  task        StudioTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  ownerUserId String   @map("owner_user_id")
  owner       User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  title       String   @db.VarChar(240)
  kind        String   @db.VarChar(48)
  storageProvider String @map("storage_provider") @db.VarChar(48)
  storageKey  String   @map("storage_key") @db.Text
  mimeType    String?  @map("mime_type") @db.VarChar(160)
  byteSize    BigInt?  @map("byte_size")
  sha256      String?  @db.VarChar(64)
  provenance  Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([projectId, createdAt(sort: Desc)], map: "studio_artifacts_project_created_idx")
  @@index([ownerUserId, createdAt(sort: Desc)], map: "studio_artifacts_owner_created_idx")
  @@map("studio_artifacts")
  @@schema("public")
}

/// Append-only lifecycle and verification evidence for Studio projects and tasks.
model StudioEvent {
  id          String   @id @default(uuid())
  projectId   String   @map("project_id")
  project     StudioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId      String?  @map("task_id")
  task        StudioTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  ownerUserId String   @map("owner_user_id")
  owner       User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  actorId     String?  @map("actor_id")
  eventType   String   @map("event_type") @db.VarChar(64)
  payload     Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([projectId, createdAt], map: "studio_events_project_created_idx")
  @@index([taskId, createdAt], map: "studio_events_task_created_idx")
  @@index([ownerUserId, createdAt(sort: Desc)], map: "studio_events_owner_created_idx")
  @@map("studio_events")
  @@schema("public")
}


/// Durable liveness records for independently deployed Studio worker processes.
model StudioWorkerHeartbeat {
  workerId   String   @id @map("worker_id") @db.VarChar(160)
  status     String   @default("starting") @db.VarChar(24)
  startedAt  DateTime @default(now()) @map("started_at") @db.Timestamptz(6)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  stoppedAt  DateTime? @map("stopped_at") @db.Timestamptz(6)
  metadata   Json     @default("{}")

  @@index([status, lastSeenAt(sort: Desc)], map: "studio_worker_heartbeats_status_seen_idx")
  @@map("studio_worker_heartbeats")
  @@schema("public")
}

/// Owner-verified destinations eligible for outbound RyanAI communications.
model CommsVerifiedDestination {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerUserId       String    @map("owner_user_id") @db.Uuid
  channel           String
  address           String
  normalizedAddress String    @map("normalized_address")
  verifiedAt        DateTime  @map("verified_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([ownerUserId, channel, normalizedAddress], map: "comms_verified_destinations_owner_channel_address_key")
  @@index([ownerUserId, channel, normalizedAddress], map: "comms_verified_destinations_owner_active_idx")
  @@map("comms_verified_destinations")
  @@schema("public")
}

/// Short-lived Twilio Verify challenge bound to the authenticated owner and destination.
model CommsDestinationVerificationChallenge {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerUserId              String    @map("owner_user_id") @db.Uuid
  channel                  String
  address                  String
  normalizedAddress        String    @map("normalized_address")
  providerVerificationSid  String    @map("provider_verification_sid")
  expiresAt                DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt               DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([ownerUserId, expiresAt], map: "comms_destination_challenges_owner_expiry_idx")
  @@map("comms_destination_verification_challenges")
  @@schema("public")
}

/// Immutable action digest and one-time owner approval for an outbound communication.
model CommsSendApproval {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerUserId       String    @map("owner_user_id") @db.Uuid
  channel           String
  recipient         String
  payloadHash       String    @map("payload_hash") @db.Char(64)
  payload           Json
  policyRuleId      String    @map("policy_rule_id")
  status            String    @default("pending")
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  approvedAt        DateTime? @map("approved_at") @db.Timestamptz(6)
  dispatchedAt      DateTime? @map("dispatched_at") @db.Timestamptz(6)
  providerMessageId String?   @map("provider_message_id")
  providerStatus    String?   @map("provider_status")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([ownerUserId, status, expiresAt], map: "comms_send_approvals_owner_status_expiry_idx")
  @@index([providerMessageId], map: "comms_send_approvals_provider_message_idx")
  @@map("comms_send_approvals")
  @@schema("public")
}

// Durable, provider-neutral inbox for validated external intelligence events.
model IntelligenceEventInbox {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId         String    @unique @map("event_id") @db.Uuid
  eventType       String    @map("event_type") @db.VarChar(160)
  schemaVersion   Int       @map("schema_version")
  occurredAt      DateTime  @map("occurred_at") @db.Timestamptz(6)
  sourceProvider  String    @map("source_provider") @db.VarChar(80)
  sourceService   String?   @map("source_service") @db.VarChar(80)
  correlationId   String?   @map("correlation_id") @db.VarChar(160)
  idempotencyKey  String    @map("idempotency_key") @db.VarChar(200)
  classification  String    @db.VarChar(16)
  payload         Json
  payloadHash     String    @map("payload_hash") @db.Char(64)
  status          String    @default("pending") @db.VarChar(16)
  attempts        Int       @default(0)
  maxAttempts     Int       @default(5) @map("max_attempts")
  availableAt     DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  leaseOwner      String?   @map("lease_owner") @db.VarChar(128)
  leaseExpiresAt  DateTime? @map("lease_expires_at") @db.Timestamptz(6)
  lastError       String?   @map("last_error") @db.Text
  receivedAt      DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt     DateTime? @map("processed_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  attemptsLog     IntelligenceEventAttempt[]

  @@unique([sourceProvider, idempotencyKey], map: "intelligence_event_inbox_provider_idempotency_key")
  @@index([status, availableAt, receivedAt], map: "intelligence_event_inbox_claim_idx")
  @@index([status, leaseExpiresAt], map: "intelligence_event_inbox_lease_idx")
  @@index([eventType, receivedAt(sort: Desc)], map: "intelligence_event_inbox_type_received_idx")
  @@map("intelligence_event_inbox")
  @@schema("public")
}

/// Append-only execution attempt evidence for durable intelligence events.
/// Per-attempt lifecycle evidence for durable intelligence events.
model IntelligenceEventAttempt {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventInboxId String   @map("event_inbox_id") @db.Uuid
  event        IntelligenceEventInbox @relation(fields: [eventInboxId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  attempt      Int
  workerId     String   @map("worker_id") @db.VarChar(128)
  status       String   @db.VarChar(24)
  error        String?  @db.Text
  startedAt    DateTime @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt   DateTime? @map("finished_at") @db.Timestamptz(6)

  @@unique([eventInboxId, attempt], map: "intelligence_event_attempt_event_attempt_key")
  @@index([eventInboxId, startedAt(sort: Desc)], map: "intelligence_event_attempt_event_started_idx")
  @@index([status, startedAt(sort: Desc)], map: "intelligence_event_attempt_status_started_idx")
  @@map("intelligence_event_attempts")
  @@schema("public")
}


/// Monotonic sequence allocator for one trusted audience/channel pair.
model RealtimeChannelSequence {
  audienceType String   @map("audience_type") @db.VarChar(24)
  audienceId   String   @map("audience_id") @db.VarChar(160)
  channel      String   @db.VarChar(120)
  nextSequence BigInt   @default(0) @map("next_sequence")
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([audienceType, audienceId, channel])
  @@map("realtime_channel_sequences")
  @@schema("public")
}

/// Durable UI event history. Audience values must be derived by trusted server code.
model RealtimeEvent {
  id           String   @id @default(uuid()) @db.Uuid
  audienceType String   @map("audience_type") @db.VarChar(24)
  audienceId   String   @map("audience_id") @db.VarChar(160)
  channel      String   @db.VarChar(120)
  sequence     BigInt
  eventType    String   @map("event_type") @db.VarChar(160)
  payload      Json
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(6)

  @@unique([audienceType, audienceId, channel, sequence], map: "realtime_events_audience_channel_sequence_key")
  @@index([audienceType, audienceId, channel, expiresAt, sequence], map: "realtime_events_replay_idx")
  @@index([expiresAt], map: "realtime_events_retention_idx")
  @@map("realtime_events")
  @@schema("public")
}
