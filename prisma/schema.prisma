datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Supabase Auth owns the auth schema; Prisma models and drift checks own public only.
  schemas  = ["public"]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  USER
  ASSISTANT
  SYSTEM
  TOOL
  @@schema("public")
}

enum AgentStatus {
  IDLE
  RUNNING
  COMPLETED
  FAILED
  PAUSED
  @@schema("public")
}

// ==========================================
// CUSTOM RYANAI BACKEND MODELS
// ==========================================

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  passwordHash  String?         @map("password_hash")
  name          String?         @map("name")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  sessions      Session[]
  agentSessions AgentSession[]
  memories      MemoryVault[]
  agents        AgentInstance[]
  agentRuns     AgentRun[]
  codingTasks   CodingTask[]
  quantExperiments QuantExperiment[]
  marketDataImports QuantMarketDataImport[]
  marketDataEvents QuantMarketDataEvent[]
  strategySignals QuantStrategySignal[]
  paperOrderProposals QuantPaperOrderProposal[]
  quantPaperAccount QuantPaperAccount?
  quantPaperDailyRiskStates QuantPaperDailyRiskState[]
  quantPaperPositions QuantPaperPosition[]
  quantPaperOrders QuantPaperOrder[]
  quantPaperTrades QuantPaperTrade[]
  quantPaperRiskPolicy QuantPaperRiskPolicy?
  quantPaperStrategies QuantPaperStrategy[]
  quantPaperPortfolioRiskState QuantPaperPortfolioRiskState?
  audiobookProjects AudiobookProject[]
  audiobookRenderJobs AudiobookRenderJob[]
  studioProjects StudioProject[]
  studioTasks StudioTask[]
  studioArtifacts StudioArtifact[]
  studioEvents StudioEvent[]

  @@map("users")
  @@schema("public")
}

model Session {
  id        String    @id @default(uuid())
  title     String    @default("New Reasoning Session")
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("sessions")
  @@schema("public")
}

model Message {
  id        String   @id @default(uuid())
  sessionId String   @map("session_id")
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      Role
  content   String   @db.Text
  reasoning String?  @db.Text
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([sessionId])
  @@map("session_messages")
  @@schema("public")
}

model AgentSession {
  id          String         @id @default(uuid())
  operator    String         @default("Ntsiyeni Ganyane")
  activeGraph String         @default("ReAct-v2.1") @map("active_graph")
  cudaActive  Boolean        @default(true) @map("cuda_active")
  userId      String?        @map("user_id")
  user        User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  messages    AgentMessage[]

  @@index([createdAt])
  @@index([userId])
  @@map("agent_sessions")
  @@schema("public")
}

model AgentMessage {
  id             String       @id @default(uuid())
  sessionId      String       @map("session_id")
  session        AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role           Role         @default(USER)
  content        String       @db.Text
  reasoningSteps String       @db.Text @map("reasoning_steps")
  latencyMs      Int          @default(14) @map("latency_ms")
  timestamp      String
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([sessionId])
  @@map("agent_messages")
  @@schema("public")
}

model AgentInstance {
  id          String      @id @default(uuid())
  name        String
  description String?
  status      AgentStatus @default(IDLE)
  userId      String      @map("user_id")
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  config      Json?
  lastActive  DateTime    @default(now()) @map("last_active")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@index([userId])
  @@map("agent_instances")
  @@schema("public")
}

model MemoryVault {
  id        String   @id @default(uuid())
  title     String
  content   String   @db.Text
  category  String   @default("general")
  tags      String[]
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("memory_vault")
  @@schema("public")
}

model SystemTelemetry {
  id          String   @id @default(uuid())
  cpuUsage    Float?   @map("cpu_usage")
  memoryUsage Float?   @map("memory_usage")
  activeNodes Int?     @map("active_nodes")
  status      String   @default("healthy")
  payload     Json?
  recordedAt  DateTime @default(now()) @map("recorded_at")

  @@map("system_telemetry")
  @@schema("public")
}

// ==========================================
// SUPABASE INTEGRATED MODELS
// ==========================================

/// Shared-room metadata. Supabase Auth owns UUID identities and room RLS.
model Room {
  id        String        @id @db.Uuid
  name      String
  createdBy String        @map("created_by") @db.Uuid
  createdAt DateTime      @map("created_at") @db.Timestamptz(6)

  @@map("rooms")
  @@schema("public")
}

model RoomMember {
  roomId   String   @map("room_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  joinedAt DateTime @map("joined_at") @db.Timestamptz(6)

  @@id([roomId, userId])
  @@map("room_members")
  @@schema("public")
}

model RoomMessage {
  id        String   @id @db.Uuid
  roomId    String   @map("room_id") @db.Uuid
  senderId  String   @map("sender_id") @db.Uuid
  body      String   @db.Text
  createdAt DateTime @map("created_at") @db.Timestamptz(6)

  @@map("room_messages")
  @@schema("public")
}

model Profile {
  id        String    @id @db.Uuid
  email     String?
  fullName  String?   @map("full_name")
  avatarUrl String?   @map("avatar_url")
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("profiles")
  @@schema("public")
}

model Conversation {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String           @default(dbgenerated("auth.uid()")) @map("user_id") @db.Uuid
  title     String           @default("New Thread")
  model     String           @default("claude-sonnet-4.6")
  createdAt DateTime?        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime?        @default(now()) @map("updated_at") @db.Timestamptz(6)
  messages  ChatSqlMessage[]

  @@index([userId])
  @@map("conversations")
  @@schema("public")
}

model ChatSqlMessage {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  role           String
  content        String       @db.Text
  model          String?
  steps          Json?
  metadata       Json?
  createdAt      DateTime?    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([conversationId])
  @@map("messages")
  @@schema("public")
}

model MemoryEntry {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @default(dbgenerated("auth.uid()")) @map("user_id") @db.Uuid
  key       String
  value     String    @db.Text
  category  String    @default("preference")
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([userId, key], map: "memory_entries_user_key_idx")
  @@index([userId])
  @@map("memory_entries")
  @@schema("public")
}

model ScheduledTask {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  prompt          String    @db.Text
  runAt           DateTime  @map("run_at")
  intervalMinutes Int?      @map("interval_minutes")
  status          String    @default("active")
  lastRunAt       DateTime? @map("last_run_at")
  lastResult      String?   @map("last_result") @db.Text
  lastError       String?   @map("last_error") @db.Text
  lockedUntil     DateTime? @map("locked_until")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([status, runAt])
  @@index([userId])
  @@map("scheduled_tasks")
  @@schema("public")
}

// An outbound action that the agent asked for. Nothing leaves the server until an
// administrator approves it. status: pending, approved, rejected, executed, failed.
model PendingAction {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tool      String
  args      Json
  summary   String    @db.Text
  status    String    @default("pending")
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")
  decidedAt DateTime? @map("decided_at")
  decidedBy String?   @map("decided_by")
  result    String?   @db.Text

  @@index([status, expiresAt])
  @@index([userId])
  @@map("pending_actions")
  @@schema("public")
}


model QuantPaperAccount {
  userId       String   @id @map("user_id")
  cashBalance  Decimal  @default(100000) @map("cash_balance") @db.Decimal(24, 8)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("quant_paper_accounts")
  @@schema("public")
}

model QuantPaperPosition {
  userId            String  @map("user_id")
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol            String  @db.VarChar(15)
  quantity          Decimal @db.Decimal(24, 8)
  averageEntryPrice Decimal @map("average_entry_price") @db.Decimal(24, 8)
  lastPrice         Decimal @map("last_price") @db.Decimal(24, 8)
  updatedAt         DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@id([userId, symbol])
  @@map("quant_paper_positions")
  @@schema("public")
}

model QuantPaperOrder {
  id                  String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId              String   @map("user_id")
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientOrderId       String   @map("client_order_id") @db.VarChar(64)
  symbol              String   @db.VarChar(15)
  side                String   @db.VarChar(4)
  quantity             Decimal  @db.Decimal(24, 8)
  referencePrice       Decimal  @map("reference_price") @db.Decimal(24, 8)
  fillPrice            Decimal  @map("fill_price") @db.Decimal(24, 8)
  fee                  Decimal  @db.Decimal(24, 8)
  status               String   @default("filled") @db.VarChar(16)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  filledQuantity       Decimal  @default(0) @map("filled_quantity") @db.Decimal(24, 8)
  remainingQuantity    Decimal  @default(0) @map("remaining_quantity") @db.Decimal(24, 8)
  averageFillPrice     Decimal? @map("average_fill_price") @db.Decimal(24, 8)
  updatedAt            DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  trades              QuantPaperTrade[]
  proposals           QuantPaperOrderProposal[]

  @@unique([userId, clientOrderId], map: "quant_paper_orders_idempotency_key")
  @@index([userId, createdAt(sort: Desc)], map: "quant_paper_orders_user_created_idx")
  @@map("quant_paper_orders")
  @@schema("public")
}

model QuantPaperTrade {
  id           String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  orderId      String   @map("order_id")
  userId       String   @map("user_id")
  order        QuantPaperOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol       String   @db.VarChar(15)
  side         String   @db.VarChar(4)
  quantity     Decimal  @db.Decimal(24, 8)
  price        Decimal  @db.Decimal(24, 8)
  fee          Decimal  @db.Decimal(24, 8)
  realizedPnl  Decimal? @map("realized_pnl") @db.Decimal(24, 8)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  clientFillId String   @map("client_fill_id") @db.VarChar(96)

  @@index([userId, createdAt(sort: Desc)], map: "quant_paper_trades_user_created_idx")
  @@index([userId, orderId], map: "quant_paper_trades_user_order_idx")
  @@unique([userId, clientFillId], map: "quant_paper_trades_user_client_fill_id_key")
  @@map("quant_paper_trades")
  @@schema("public")
}

model QuantPaperRiskPolicy {
  userId              String   @id @map("user_id")
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  maxOrderNotional    Decimal  @default(10000) @map("max_order_notional") @db.Decimal(18, 2)
  maxPositionNotional Decimal  @default(25000) @map("max_position_notional") @db.Decimal(18, 2)
  maxGrossExposure    Decimal  @default(75000) @map("max_gross_exposure") @db.Decimal(18, 2)
  tradingEnabled      Boolean  @default(true) @map("trading_enabled")
  maxDailyLoss        Decimal  @default(5000) @map("max_daily_loss") @db.Decimal(18, 2)
  maxDrawdownPct      Decimal  @default(10) @map("max_drawdown_pct") @db.Decimal(6, 2)
  emergencyStop       Boolean  @default(false) @map("emergency_stop")
  emergencyStopReason String?  @map("emergency_stop_reason") @db.Text
  emergencyStoppedAt  DateTime? @map("emergency_stopped_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("quant_paper_risk_policies")
  @@schema("public")
}

model QuantPaperStrategy {
  id            String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId        String          @map("user_id")
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  experimentId  String          @map("experiment_id")
  experiment    QuantExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  allocationPct Decimal         @default(10) @map("allocation_pct") @db.Decimal(5, 2)
  enabled       Boolean         @default(true)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([userId, experimentId], map: "quant_paper_strategies_user_experiment_key")
  @@index([userId, enabled, createdAt(sort: Desc)], map: "quant_paper_strategies_user_enabled_idx")
  @@map("quant_paper_strategies")
  @@schema("public")
}

model QuantPaperPortfolioRiskState {
  userId         String   @id @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  peakEquity     Decimal  @map("peak_equity") @db.Decimal(24, 8)
  currentEquity  Decimal  @map("current_equity") @db.Decimal(24, 8)
  maxDrawdownPct Decimal  @default(0) @map("max_drawdown_pct") @db.Decimal(8, 4)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("quant_paper_portfolio_risk_state")
  @@schema("public")
}

model QuantPaperDailyRiskState {
  userId         String   @map("user_id")
  riskDate       DateTime @map("risk_date") @db.Date
  startingEquity Decimal  @map("starting_equity") @db.Decimal(24, 8)
  currentEquity  Decimal  @map("current_equity") @db.Decimal(24, 8)
  dailyLoss      Decimal  @default(0) @map("daily_loss") @db.Decimal(24, 8)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([userId, riskDate])
  @@index([riskDate(sort: Desc)], map: "quant_paper_daily_risk_state_date_idx")
  @@map("quant_paper_daily_risk_state")
  @@schema("public")
}

model AgentRun {
  id String @id @default(uuid())
  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  objective String @db.Text
  requestedModel String? @map("requested_model")
  traceContext Json? @map("trace_context")
  executionScope Json @default("{}") @map("execution_scope")
  approvalStatus String @default("approved") @map("approval_status")
  planSnapshot Json? @map("plan_snapshot")
  planHash String? @map("plan_hash")
  baseCommitSha String? @map("base_commit_sha")
  proposedDiffHash String? @map("proposed_diff_hash")
  approvedPlanHash String? @map("approved_plan_hash")
  approvedCommitSha String? @map("approved_commit_sha")
  approvedDiffHash String? @map("approved_diff_hash")
  approvedBy String? @map("approved_by")
  approvedAt DateTime? @map("approved_at")
  steeringNotes String? @db.Text @map("steering_notes")
  cancelRequestedAt DateTime? @map("cancel_requested_at")
  status String @default("queued")
  result Json?
  error String? @db.Text
  attempts Int @default(0)
  maxAttempts Int @default(3) @map("max_attempts")
  workerId String? @map("worker_id")
  lockedAt DateTime? @map("locked_at")
  leaseExpiresAt DateTime? @map("lease_expires_at")
  heartbeatAt DateTime? @map("heartbeat_at")
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  completedAt DateTime? @map("completed_at")
  handoffs AgentHandoff[]
  evidence AgentRunEvidence[]
  codingTasks CodingTask[]
  paDelegation PaDelegation?
  queueType String @default("reasoning") @map("queue_type")
  @@index([queueType, status, createdAt], map: "agent_runs_queue_type_status_created_idx")
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([status, lockedAt])
  @@index([status, nextAttemptAt])
  @@index([status, nextAttemptAt, leaseExpiresAt], map: "agent_runs_status_next_attempt_lease_idx")
  @@index([workerId, leaseExpiresAt], map: "agent_runs_worker_lease_idx")
  @@index([approvalStatus, createdAt], map: "agent_runs_approval_status_created_idx")
  @@map("agent_runs")
  @@schema("public")
}
model PaIdentityNonce {
  id String @id @default(uuid()) @db.Uuid
  nonce String @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@index([expiresAt])
  @@map("pa_identity_nonces")
  @@schema("public")
}

model PaDelegation {
  id String @id @default(uuid()) @db.Uuid
  ownerUserId String @map("owner_user_id")
  objective String @db.Text
  requestedCapabilities Json @map("requested_capabilities")
  status String @default("queued")
  traceId String @map("trace_id")
  agentRunId String? @unique @map("agent_run_id")
  agentRun AgentRun? @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  receipt PaExecutionReceipt?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  @@index([ownerUserId, createdAt])
  @@index([status, createdAt])
  @@map("pa_delegations")
  @@schema("public")
}

model PaExecutionReceipt {
  id String @id @default(uuid()) @db.Uuid
  delegationId String @unique @map("delegation_id") @db.Uuid
  delegation PaDelegation @relation(fields: [delegationId], references: [id], onDelete: Cascade)
  agentRunId String @map("agent_run_id")
  status String
  traceId String @map("trace_id")
  attempt Int
  result Json?
  error String? @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@index([agentRunId, createdAt])
  @@index([traceId, createdAt])
  @@map("pa_execution_receipts")
  @@schema("public")
}

model AgentRunEvidence {
  id String @id @default(uuid())
  runId String @map("run_id")
  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  sequence Int
  eventType String @map("event_type")
  actorId String? @map("actor_id")
  payload Json
  previousHash String? @map("previous_hash")
  hash String @unique
  createdAt DateTime @default(now()) @map("created_at")
  @@unique([runId, sequence], map: "agent_run_evidence_run_sequence_key")
  @@index([runId, sequence], map: "agent_run_evidence_run_sequence_idx")
  @@map("agent_run_evidence")
  @@schema("public")
}
model AgentHandoff {
  id String @id @default(uuid())
  runId String @map("run_id")
  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  fromAgent String @map("from_agent")
  toAgent String @map("to_agent")
  status String @default("pending")
  input String @db.Text
  output String? @db.Text
  error String? @db.Text
  startedAt DateTime @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")
  @@index([runId, startedAt])
  @@map("agent_handoffs")
  @@schema("public")
}
model AgentBrainHealth {
  id String @id @default(uuid())
  brain String @unique
  model String
  status String
  latencyMs Int? @map("latency_ms")
  lastSuccessAt DateTime? @map("last_success_at")
  lastError String? @db.Text @map("last_error")
  checkedAt DateTime @default(now()) @map("checked_at")
  @@map("agent_brain_health")
  @@schema("public")
}


// Curated platform-wide knowledge supplied to every reasoning brain.
model BrainKnowledge {
  id          String   @id @default(uuid())
  fingerprint String   @unique
  title       String
  content     String   @db.Text
  source      String?
  category    String   @default("general")
  tags        String[]
  confidence  Float    @default(0.5)
  priority    Int      @default(0)
  active      Boolean  @default(true)
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([active, priority, updatedAt])
  @@index([expiresAt])
  @@map("brain_knowledge")
  @@schema("public")
}


model CommunicationConversation {
  id              String                   @id @default(uuid())
  channel         String
  externalAddress String                   @map("external_address")
  ownerUserId     String?                  @db.Uuid @map("owner_user_id")
  createdAt       DateTime                 @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt       DateTime                 @default(now()) @updatedAt @db.Timestamptz(6) @map("updated_at")
  messages        CommunicationMessage[]

  @@unique([channel, externalAddress], map: "communication_conversations_channel_address_key")
  @@index([channel, updatedAt], map: "communication_conversations_channel_updated_idx")
  @@index([ownerUserId, updatedAt], map: "communication_conversations_owner_updated_idx")
  @@map("communication_conversations")
  @@schema("public")
}

model CommunicationMessage {
  id                String                    @id @default(uuid())
  conversationId    String                    @map("conversation_id")
