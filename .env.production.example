# RyanAI Production overlay.
# Source of truth: https://github.com/ganyanentsiyeni-rgb/RYANAI-Automous-Reasioning-Plat-main (main).
# Overlay on .env.example. Supply production-only HTTPS origins and credentials
# through sealed platform secret storage. Never commit populated .env files.
# Config reports may show names and configured/missing/invalid state only — never values.
# Production credentials and data stores must never be shared with development or U2EB.
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
VITE_APP_ENV=production
VITE_API_BASE_URL=https://replace-with-production-api-host
VITE_SUPABASE_URL=https://replace-with-production-supabase-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=
CORS_ORIGINS=https://replace-with-production-web-host
SCHEDULER_ENABLED=false
ALERTS_ENABLED=false
COMMUNICATIONS_ENABLED=false
COMMUNICATION_ATTACHMENTS_ENABLED=false
ATTACHMENT_SCANNER_ENABLED=false
ATTACHMENT_ORPHAN_CLEANUP_ENABLED=false
