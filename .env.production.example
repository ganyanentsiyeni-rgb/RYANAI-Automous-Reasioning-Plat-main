# RyanAI Production overlay.
# Combine with .env.example. Supply Production-only HTTPS origins and credentials
# through the approved private runtime secret manager; never commit real values.
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
VITE_APP_ENV=production
# Canonical shared API gateway for all production RyanAI web frontends.
# Keep U2EB/staging isolated; do not point isolated test frontends at Production.
VITE_API_BASE_URL=https://ryanai-api-production.up.railway.app
VITE_SUPABASE_URL=https://replace-with-production-supabase-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=
CORS_ORIGINS=https://replace-with-production-web-host
SCHEDULER_ENABLED=false
ALERTS_ENABLED=false
COMMUNICATIONS_ENABLED=false
COMMUNICATION_ATTACHMENTS_ENABLED=false
ATTACHMENT_SCANNER_ENABLED=false
ATTACHMENT_ORPHAN_CLEANUP_ENABLED=false
