{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalDependencies": [
    ".env.example",
    "tsconfig*.json",
    "models/catalog.json",
    "app/routes.json"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/**",
        "app/**",
        "store/**",
        "models/**",
        "stacks/**",
        "prisma/**",
        "quant-engine/**",
        "scripts/**",
        "vite.config.ts",
        "postcss.config.js",
        "tailwind.config.js",
        "index.html",
        "tsconfig*.json"
      ],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["build"]
    }
  }
}
