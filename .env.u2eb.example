# RyanAI U2EB / staging overlay.
# Source of truth: https://github.com/ganyanentsiyeni-rgb/RYANAI-Automous-Reasioning-Plat-main (main).
# Overlay on .env.example. Use only dedicated U2EB resources; never reuse production data stores or credentials.
# All credential values belong in sealed platform secrets. This file contains placeholders only.
# Config reports must redact values and report configured/missing/invalid state only.
NODE_ENV=staging
HOST=0.0.0.0
PORT=3000
VITE_APP_ENV=staging
VITE_API_BASE_URL=https://replace-with-u2eb-api-host
VITE_SUPABASE_URL=https://replace-with-u2eb-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=

# Server-side database connection. Keep the real password only in sealed runtime secrets.
# URL-encode reserved password characters before inserting them into this URI.
DATABASE_URL=postgresql://replace-with-u2eb-db-user:replace-with-u2eb-db-password@replace-with-u2eb-pooler-host:5432/replace-with-u2eb-db?sslmode=verify-full
REDIS_URL=redis://replace-with-u2eb-redis-host:6379

# Pooler routing values are public configuration, not credentials.
SUPABASE_URL=https://replace-with-u2eb-project.supabase.co
SUPABASE_SESSION_POOLER_HOST=replace-with-u2eb-pooler-host
SUPABASE_SSL_ROOT_CERT_PATH=/usr/local/share/ca-certificates/supabase-prod-ca-2021.crt

CORS_ORIGINS=https://replace-with-u2eb-web-host
SCHEDULER_ENABLED=false
ALERTS_ENABLED=false
COMMUNICATIONS_ENABLED=false
COMMUNICATION_ATTACHMENTS_ENABLED=false
ATTACHMENT_SCANNER_ENABLED=false
ATTACHMENT_ORPHAN_CLEANUP_ENABLED=false
