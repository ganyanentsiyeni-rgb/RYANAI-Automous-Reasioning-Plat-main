# RyanAI U2EB / staging overlay.
# Combine with .env.example. Use only the dedicated U2EB Supabase project.
# Never reuse Production database, Redis, Supabase service-role, or provider secrets.
NODE_ENV=staging
HOST=0.0.0.0
PORT=3000
VITE_APP_ENV=staging
VITE_API_BASE_URL=https://replace-with-u2eb-api-host
VITE_SUPABASE_URL=https://omqavyppdoniehseokvx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=

# Server-side database connection. Keep the real password only in Render secrets.
# URL-encode reserved password characters before inserting them into this URI.
DATABASE_URL=postgresql://postgres.omqavyppdoniehseokvx:replace_with_u2eb_database_password@aws-1-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=verify-full
REDIS_URL=redis://replace-with-u2eb-redis-host:6379

# Pooler routing values are public configuration, not credentials.
SUPABASE_URL=https://omqavyppdoniehseokvx.supabase.co
SUPABASE_SESSION_POOLER_HOST=aws-1-eu-central-1.pooler.supabase.com
SUPABASE_SSL_ROOT_CERT_PATH=/usr/local/share/ca-certificates/supabase-prod-ca-2021.crt

CORS_ORIGINS=https://replace-with-u2eb-web-host
SCHEDULER_ENABLED=false
ALERTS_ENABLED=false
COMMUNICATIONS_ENABLED=false
COMMUNICATION_ATTACHMENTS_ENABLED=false
ATTACHMENT_SCANNER_ENABLED=false
ATTACHMENT_ORPHAN_CLEANUP_ENABLED=false
