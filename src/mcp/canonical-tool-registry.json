      "timeoutMs": 10000,
      "idempotency": "safe",
      "productionAccess": false,
      "secretAccess": false,
      "description": "Read a source file securely from the RyanAI workspace directory.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "filePath": {
            "type": "string"
          }
        },
        "required": [
          "filePath"
        ]
      }
    },
    {
