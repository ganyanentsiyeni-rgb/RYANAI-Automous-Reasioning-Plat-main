      "approval": "none",
      "audit": "required",
      "timeoutMs": 10000,
      "idempotency": "safe",
      "productionAccess": false,
      "secretAccess": false,
      "description": "Read Git status and whitespace diagnostics.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "ryanai_stack_manifest",
      "owner": "platform",
      "risk": "read-only",
      "capability": "platform.stack.read",
      "execution": "none",
      "approval": "none",
      "audit": "required",
      "timeoutMs": 5000,
      "idempotency": "safe",
