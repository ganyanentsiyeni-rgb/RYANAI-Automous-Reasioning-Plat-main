    {
      "name": "get_system_health",
      "owner": "platform",
      "risk": "read-only",
      "capability": "system.health.read",
      "execution": "process-read",
      "approval": "none",
      "audit": "required",
      "timeoutMs": 5000,
      "idempotency": "safe",
