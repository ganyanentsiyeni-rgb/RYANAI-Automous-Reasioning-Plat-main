      "owner": "engineering",
      "risk": "code-execution",
      "capability": "sandbox.execute",
      "execution": "sandbox-process",
      "approval": "human-before-execution",
      "audit": "required",
      "timeoutMs": 120000,
      "idempotency": "best-effort",
      "productionAccess": false,
      "secretAccess": false,
      "description": "Execute code in the isolated RyanAI sandbox; external MCP clients are denied until Gen-X permits the action.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "scriptContent": {
            "type": "string"
          },
          "fileName": {
            "type": "string"
          }
        },
        "required": [
          "scriptContent"
        ]
      }
    },
    {
      "name": "system_diagnostics",
      "owner": "platform",
      "risk": "read-only",
      "capability": "system.diagnostics.read",
      "execution": "local-diagnostics",
      "approval": "none",
      "audit": "required",
      "timeoutMs": 10000,
      "idempotency": "safe",
      "productionAccess": false,
      "secretAccess": false,
      "description": "Inspect local GPU, memory, or general system telemetry.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "queryType": {
            "type": "string",
            "enum": [
              "memory",
