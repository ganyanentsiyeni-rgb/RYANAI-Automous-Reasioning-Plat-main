    {
      "name": "platform_health",
      "owner": "platform",
      "risk": "network-read",
      "capability": "platform.health.read",
      "execution": "bounded-http-read",
      "approval": "none",
      "audit": "required",
      "timeoutMs": 5000,
      "idempotency": "safe",
      "productionAccess": false,
      "secretAccess": false,
      "description": "Read the configured RyanAI API health endpoint.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "reasoning_route",
      "owner": "reasoning",
      "risk": "external-model-request",
      "capability": "reasoning.request",
      "execution": "approved-provider-request",
      "approval": "user-requested-task",
      "audit": "required",
      "timeoutMs": 120000,
      "idempotency": "non-idempotent",
      "productionAccess": false,
      "secretAccess": false,
      "description": "Send a prompt to a configured reasoning provider.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "maxLength": 20000
          },
          "provider": {
            "type": "string"
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "response_format": {
            "type": "string",
            "enum": [
              "text",
              "json_object"
            ]
          }
        },
        "required": [
          "prompt",
          "provider",
          "model"
        ]
      }
    },
    {
      "name": "comms_policy_read",
      "owner": "communications",
      "risk": "read-only",
      "capability": "communications.policy.read",
      "execution": "none",
      "approval": "none",
      "audit": "required",
      "timeoutMs": 5000,
      "idempotency": "safe",
      "productionAccess": false,
      "secretAccess": false,
      "description": "Read channel consent and safety policy; no private history or provider access.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "channel": {
            "type": "string",
            "enum": [
              "whatsapp",
              "sms",
              "voice",
              "email"
            ]
          }
        },
        "required": [
          "channel"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "comms_draft_prepare",
      "owner": "communications",
      "risk": "draft-only",
      "capability": "communications.draft.prepare",
      "execution": "draft-generation",
      "approval": "human-before-dispatch",
      "audit": "required",
      "timeoutMs": 10000,
      "idempotency": "safe",
      "productionAccess": false,
      "secretAccess": false,
      "description": "Prepare a communications draft for human approval; never dispatch.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "channel": {
            "type": "string",
            "enum": [
              "whatsapp",
              "sms",
              "voice",
              "email"
            ]
          },
          "recipient": {
            "type": "string",
            "minLength": 1,
            "maxLength": 320
          },
          "subject": {
            "type": "string",
            "maxLength": 200
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "channel",
          "recipient",
          "message"
        ],
        "additionalProperties": false
      }
    },
