# RyanAI — U2EB Supabase connection contract
# Copy to .env (ignored by Git). Names only: populate values privately in your local environment.
# Never commit a real database password, API key, or service-role credential.
SUPABASE_URL=
SUPABASE_SESSION_POOLER_HOST=
# Paste the exact project-qualified Session Pooler URI privately; URL-encode reserved password characters.
DATABASE_URL=
DIRECT_URL=

# Dedicated audiobook database (server-side only; never use these as VITE_* variables).
# AUDIOBOOK_DATABASE_URL is the pooled runtime connection.
# AUDIOBOOK_DATABASE_URL_UNPOOLED is the direct connection used by Prisma migrations.
AUDIOBOOK_DATABASE_URL=
AUDIOBOOK_DATABASE_URL_UNPOOLED=

# Optional OpenRouter model overrides for Logic synthesis only.
# Leave OPENROUTER_API_KEY empty to keep OpenRouter unavailable.
# Server-side only: never prefix credentials with VITE_ or expose them to browser/MCP clients.
OPENROUTER_API_KEY=
OPENROUTER_API_ENDPOINT=
# Legacy aliases are accepted during migration; prefer *_API_ENDPOINT and *_MODEL_ALLOWLIST.
OPENROUTER_BASE_URL=
OPENROUTER_MODEL_ALLOWLIST=
OPENROUTER_DEFAULT_MODE=

# Local frontend wiring. These are public/browser-safe values only.
VITE_APP_ENV=
VITE_API_BASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Additional server-side provider credentials. Configure only the providers
# actually selected by RyanAI; never expose these through VITE_* variables.
ANTHROPIC_API_KEY=
ANTHROPIC_API_ENDPOINT=
ANTHROPIC_DEFAULT_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_API_ENDPOINT=
DASHSCOPE_API_KEY=
QWEN_API_KEY=
QWEN_API_ENDPOINT=
TOGETHER_API_KEY=
TOGETHER_API_ENDPOINT=
NVIDIA_API_KEY=
NVIDIA_API_ENDPOINT=
XAI_API_KEY=
XAI_BASE_URL=
XAI_DEFAULT_MODEL=
GROK_API_KEY=
GROK_API_ENDPOINT=
GROK_MODEL=
OPENAI_API_KEY=
OPENAI_API_ENDPOINT=
OPENAI_BASE_URL=
OPENAI_MODEL=
RYANAI_MODEL_PROVIDER=
RYANAI_DEV_MODEL_KEY=
RYANAI_PROD_MODEL_KEY=
NODE_ENV=
NODE_ENV=

# Backend / CORS Origins
# Browser origins allowed to call the API; keep production origins explicit.
CORS_ORIGINS=

# Optional external database integrations (configure privately; never commit credentials).
NEON_DATABASE_URL=
MONGODB_URI=
