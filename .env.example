# ============================================================
# RyanAI — Local Development / Docker Compose Environment
# Copy this file to .env and replace the required placeholders.
# NEVER commit .env or real secrets.
#
# Use hex-only passwords for DB_PASSWORD and REDIS_PASSWORD
# because Compose inserts them into connection URLs.
# ============================================================

# Core security secrets — generate unique random values
DB_PASSWORD=replace_with_64_hex_characters
REDIS_PASSWORD=replace_with_64_hex_characters
JWT_SECRET=replace_with_a_unique_random_secret_at_least_32_characters
MCP_AUTH_TOKEN=replace_with_a_different_random_token_at_least_32_characters

# ============================================================
# Frontend
# ============================================================

# Blank uses same-origin API requests (Nginx proxy in Compose,
# Vite proxy in development). Set HTTPS API origin for separate hosting.
VITE_API_BASE_URL=
VITE_APP_ENV=development

# Public/publishable Supabase frontend configuration only.
# The project URL is public; the publishable key is required for Data API access.
VITE_SUPABASE_URL=https://narsvpwymvlrhurqbthu.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=

# ============================================================
# API / DATABASE / REDIS
# ============================================================

# Local development connection strings.
# Compose overrides these inside the API container.
DATABASE_URL=postgresql://ryanai:replace_with_64_hex_characters@127.0.0.1:5432/ryanai_db
# Optional dedicated Neon audiobook database; never substitute these for DATABASE_URL.
# Use the pooled URL for API/worker traffic and the direct URL only for migrations.
AUDIOBOOK_DATABASE_URL=
AUDIOBOOK_DATABASE_URL_UNPOOLED=
REDIS_URL=redis://:replace_with_64_hex_characters@127.0.0.1:6379

HOST=127.0.0.1
PORT=3001
NODE_ENV=development

CORS_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,http://localhost:9090,http://127.0.0.1:9090

# ============================================================
# AI PROVIDERS — SERVER-SIDE CREDENTIALS ONLY
# Never use VITE_* prefixes for private provider keys.
# ============================================================

# NVIDIA — Primary reasoning brain
NVIDIA_API_KEY=
NVIDIA_API_ENDPOINT=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
PRIMARY_REASONING_PROVIDER=nvidia

# Qwen — Secondary reasoning brain.
# The API selects a provider key by the hostname in QWEN_API_ENDPOINT.
# QWEN_API_KEY is the compatibility fallback for custom endpoints.
DASHSCOPE_API_KEY=
QWEN_API_KEY=
QWEN_API_ENDPOINT=https://api.together.xyz/v1
QWEN_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507-tput
SECONDARY_REASONING_PROVIDER=qwen

# Grok/xAI — optional Logic-brain provider and direct MCP gateway route.
# Select LOGIC_REASONING_PROVIDER=grok only after the model ID and key are configured.
# No key is generated or provisioned by this template.
GROK_API_KEY=
GROK_API_ENDPOINT=https://api.x.ai/v1
GROK_MODEL=


# DeepSeek — Optional OpenAI-compatible local model server (e.g. DGX Spark cluster)
# Loopback is the safe default. Remote endpoints require DEEPSEEK_API_KEY.
DEEPSEEK_API_KEY=
DEEPSEEK_API_ENDPOINT=http://127.0.0.1:8888/v1
DEEPSEEK_MODEL=DeepSeek-V4.1-Flash-1017
# Optional comma-separated API gateway allowlist; defaults to DEEPSEEK_MODEL when unset.
DEEPSEEK_MODEL_ALLOWLIST=

# TorchTPU — optional OpenAI-compatible serving endpoint backed by vLLM/SGLang + TorchTPU.
# TorchTPU is a PyTorch device backend, not an HTTP server; deploy a serving runtime separately.
TORCHTPU_API_KEY=
TORCHTPU_API_ENDPOINT=http://127.0.0.1:8000/v1
TORCHTPU_MODEL=
# Read-only MCP tools enabled by default in Compose. Reasoning and diagnostic execution require explicit operator allowlisting.
# Add run_project_checks explicitly when Jarvis is authorized to execute the fixed validation suite.
RYANAI_MCP_ENABLED_TOOLS=platform_health,repository_status,ryanai_stack_manifest

# Optional MCPJungle enterprise gateway profile (docker compose --profile mcp-gateway up -d)
# Generate a URL-safe password, e.g. openssl rand -hex 32. Never reuse DB_PASSWORD.
MCPJUNGLE_DB_PASSWORD=
MCPJUNGLE_IMAGE_TAG=0.4.6
MCPJUNGLE_HOST_PORT=8080

# ============================================================
# CLOUDFLARE EDGE — OPTIONAL, CLOUD-FIRST MCP GATEWAY
# Configure the Tunnel and Access policy in Cloudflare first.
# Keep all tokens in the private deployment secret manager.
# ============================================================

# Versioned development default. Before shared/cloud activation, override with a reviewed immutable image digest.
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.10.0
# Tunnel token from the named Cloudflare Tunnel. Inject via private runtime environment only.
# Docker Compose mounts it as /run/secrets/cloudflare_tunnel_token for cloudflared.
CLOUDFLARE_TUNNEL_TOKEN=
# Intended hostname; requires the domain to be registered and added to Cloudflare.
CLOUDFLARE_MCP_HOSTNAME=mcp.ryanai.dev

# OpenAI — One server-side credential shared by RyanAI API, agents, MCP gateway and Comms.
# Keep only in the API runtime secret manager; never use a VITE_ prefix or inject into MCP.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=
# Optional comma-separated direct OpenAI API model allowlist; defaults to OPENAI_MODEL when unset.
OPENAI_MODEL_ALLOWLIST=
# Optional native Anthropic Messages API integration. A model must be explicitly allowlisted.
ANTHROPIC_API_KEY=
ANTHROPIC_API_ENDPOINT=https://api.anthropic.com/v1
ANTHROPIC_MODEL_ALLOWLIST=

# Separate private MCP-to-API service credential (not the OpenAI provider key).
# Delegated identity signing is a separate key. Keep both empty in this template;
# provision unique random values only in the approved private runtime secret manager.
RYANAI_MCP_SERVICE_TOKEN=
RYANAI_MCP_DELEGATION_SECRET=
# The old service-token-only model gateway stays disabled until PR C integrates delegated identity.
RYANAI_OPENAI_GATEWAY_ENABLED=false
RYANAI_OPENAI_GATEWAY_TOKEN=replace_with_a_different_random_token_at_least_32_characters
RYANAI_OPENAI_GATEWAY_URL=http://api:3000/api/internal/openai/chat

# Logic — Independent reasoning and synthesis brain.
# LOGIC_API_KEY takes precedence; OPENAI_API_KEY is used only when it is blank.
LOGIC_API_KEY=
LOGIC_API_ENDPOINT=https://api.openai.com/v1
LOGIC_REASONING_MODEL=gpt-4o-mini
LOGIC_REASONING_PROVIDER=logic

# Together AI — used automatically when QWEN_API_ENDPOINT targets Together.
TOGETHER_API_KEY=
TOGETHER_API_ENDPOINT=https://api.together.xyz/v1
TOGETHER_MODEL=

# Optional server-only key for the ChatGPT and Claude Inference Console choices.
# OpenRouter — used automatically when QWEN_API_ENDPOINT targets OpenRouter.
OPENROUTER_API_KEY=
OPENROUTER_API_ENDPOINT=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
# Optional comma-separated OpenRouter allowlist; kept separate from native OpenAI/Anthropic providers.
OPENROUTER_MODEL_ALLOWLIST=

# Alibaba Model Studio and SiliconFlow keys are selected by QWEN_API_ENDPOINT host.
# DashScope API keys are region-bound; use the endpoint for the same region.
SILICONFLOW_API_KEY=

# Optional OpenAI-compatible private/local gateways (server-side only).
MODEL_GATEWAY_API_KEY=
MODEL_GATEWAY_URL=http://127.0.0.1:8000/v1
LOCAL_API_KEY=
LOCAL_MODEL_URL=http://127.0.0.1:8080/v1

# ============================================================
# SUPABASE — OPTIONAL SERVER-SIDE CONFIGURATION
# The API uses the same project URL; keep all privileged keys server-only.
# ============================================================

SUPABASE_URL=https://narsvpwymvlrhurqbthu.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional Session Pooler host for hosted Postgres connectivity; obtain from Supabase Connect.
SUPABASE_SESSION_POOLER_HOST=
SUPABASE_SSL_ROOT_CERT_PATH=/usr/local/share/ca-certificates/supabase-prod-ca-2021.crt

# IMPORTANT:
# Never expose SUPABASE_SERVICE_ROLE_KEY to frontend/browser code.

# Ollama is an optional local inference adapter, not a fourth reasoning brain.
# Select explicitly per role (for example PRIMARY_REASONING_PROVIDER=ollama).
# A selected Ollama role requires OLLAMA_MODEL and never falls back to a cloud provider.
OLLAMA_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=

# ============================================================
# MCP HTTP SERVICE
# ============================================================

MCP_HOST=127.0.0.1
MCP_PORT=8765
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# API-side PA observer endpoint for the dedicated MCP server. Remote endpoints must use HTTPS.
RYANAI_MCP_HEALTH_URL=

# ============================================================
# JARVIS INTEGRATION — DISABLED BY DEFAULT
# ============================================================

JARVIS_BASE_URL=
JARVIS_API_TOKEN=

JARVIS_SYNC_ENABLED=false
JARVIS_ALLOW_PRODUCTION_SYNC=false
JARVIS_PATCH_INGRESS_ENABLED=false
JARVIS_INGRESS_TOKEN=

JARVIS_HEALTH_PATH=/health
JARVIS_PATCH_PATH=/api/v1/patches
JARVIS_STACK_PATH=/api/v1/stacks

# ============================================================
# GITHUB SELF-PATCHING
# Fine-grained repository-scoped token only.
# Contents: Read/Write and Pull requests: Read/Write.
# Never use a broad personal access token.
# ============================================================

RYANAI_GITHUB_TOKEN=
RYANAI_GITHUB_REPOSITORY=ganyanentsiyeni-rgb/RYANAI-Automous-Reasioning-Plat-main
RYANAI_GITHUB_BASE_BRANCH=main

# ============================================================
# OPTIONAL LOCAL PATCH VERIFIER
# Use an immutable image digest.
# ============================================================

RYAN_PATCH_VERIFIER_IMAGE=

# Keep provider communications and uploads fail-closed until production security review is complete.
COMMUNICATIONS_ENABLED=false
COMMUNICATION_ATTACHMENTS_ENABLED=false
ATTACHMENT_SCANNER_ENABLED=false
ATTACHMENT_ORPHAN_CLEANUP_ENABLED=false

# ============================================================
# TWILIO — SERVER-SIDE COMMUNICATIONS (TRIAL / OWNER GATED)
# RyanAI uses Twilio for planned WhatsApp, SMS and voice channels.
# Keep credentials blank in this template and configure only in the
# private API runtime secret manager. Never use VITE_ prefixes.
# The account owner must review trial expiry and billing separately.
# ============================================================

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=


# ============================================================
# HOSTED ENVIRONMENT CONTRACT — SAFE DEFAULTS / NO CREDENTIALS
# Use the matching .env.development.example, .env.u2eb.example, or
# .env.production.example as the environment-specific overlay.
# Set secret values only in the private runtime secret manager.
# ============================================================

# Render API optional attachment scanner settings.
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=60000
ATTACHMENT_SCAN_INTERVAL_MS=5000

# Optional email delivery provider settings — credentials remain server-side.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Owner identity is runtime configuration; do not put private contact values in templates.
RYANAI_OWNER_TITLE=
RYANAI_OWNER_LANGUAGE=ve-ZA
RYANAI_OWNER_PHONE=
RYANAI_OWNER_EMAIL=

# Feature gates remain fail-closed in every example environment.
SCHEDULER_ENABLED=false
ALERTS_ENABLED=false
COMMUNICATIONS_ENABLED=false
COMMUNICATION_ATTACHMENTS_ENABLED=false
ATTACHMENT_SCANNER_ENABLED=false
ATTACHMENT_ORPHAN_CLEANUP_ENABLED=false
