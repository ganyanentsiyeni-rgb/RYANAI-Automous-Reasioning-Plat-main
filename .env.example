# ---------------------------------------------------------------------------
# 1. SUPABASE (Primary PostgreSQL / Prisma / pgvector)
# Replace <db_password> and <project-ref> with your Supabase project values.
# Use Transaction pooler (port 6543 + ?pgbouncer=true) for serverless/pooled
# connections, or Session/Direct (port 5432) for Prisma migrations.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.<project-ref>:<db_password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<project-ref>:<db_password>@db.<project-ref>.supabase.co:5432/postgres"

# ---------------------------------------------------------------------------
# 2. NEON (Audiobook PostgreSQL Workload)
# Replace <neon_user>, <neon_password>, and <endpoint-host> from Neon console.
# ---------------------------------------------------------------------------
NEON_DATABASE_URL="postgresql://<neon_user>:<neon_password>@<endpoint-host>.neon.tech/neondb?sslmode=require&channel_binding=require"

# ---------------------------------------------------------------------------
# 3. MONGODB ATLAS (Document / Catalogue / Messaging)
# Replace <db_username> with your real Atlas database user.
# Rotate he6X3CX7UknLa4Pj in Atlas if it is a live credential.
# ---------------------------------------------------------------------------
MONGODB_URI="mongodb+srv://<db_username>:he6X3CX7UknLa4Pj@cluster0.4n9xidf.mongodb.net/ryanai?retryWrites=true&w=majority&appName=Cluster0"

DATABASE_URL="postgresql://<neon_user>:<neon_password>@<endpoint-host>.neon.tech/neondb?sslmode=require&channel_binding=require",postgresql://postgres:[YOUR-DATABASE-PASSWORD]@db.omqavyppdoniehseokvx.supabase.co:5432/postgres,


# ---------------------------------------------------------------------------
# Backend / CORS Origins
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,http://localhost:3000,https://ryanai-web-u2eb.onrender.com

# ---------------------------------------------------------------------------
# Frontend (Vite) — Local Dev vs. Hosted Production
# ---------------------------------------------------------------------------
# Local development (matches your backend port 3001; switch to your hosted
# API URL when building for Render/Vercel production):
VITE_API_BASE_URL=http://127.0.0.1:3001

# Supabase Project URL (from Supabase Dashboard -> Project Settings -> Data API / API):
# Matches project ref <project-ref> used in your Supabase DATABASE_URL above.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase Publishable / Anon Key (safe for client bundle; RLS enforces access):
# Formerly labeled "anon public" in older Supabase dashboards; now shown as
# "Publishable key" (sb_publishable_...) or anon JWT in Project Settings -> API Keys.
VITE_SUPABASE_PUBLISHABLE_KEY=<your_supabase_publishable_or_anon_key>
