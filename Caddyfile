{
	auto_https off
}

:8080 {
	reverse_proxy http://mcp-server:8765 {
		# Replace gateway/client credentials with a short-lived, CI-only RyanAI
		# delegated identity. The upstream still verifies JWT signature, expiry,
		# scope, and API authorization for every tool call.
		header_up Authorization "Bearer {$MCP_PROXY_DELEGATION_TOKEN}"
		header_up Host mcp-server
		# Flush streamed MCP/SSE responses immediately; do not buffer.
		flush_interval -1
	}
}
