// Example Grafana Alloy configuration for a persistent deployment host.
// Secrets are supplied through the host environment; no credentials belong here.

loki.source.file "deployment_logs" {
  targets = [
    { "__path__" = "/var/log/deployments/*.log" },
  ]
  forward_to = [loki.write.grafana_cloud.receiver]
}

otelcol.receiver.otlp "deployment" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    metrics = [otelcol.processor.batch.deployment.input]
    logs    = [otelcol.processor.batch.deployment.input]
  }
}

otelcol.processor.batch "deployment" {
  output {
    metrics = [otelcol.exporter.prometheus.grafana_cloud.input]
    logs    = [otelcol.exporter.loki.grafana_cloud.input]
  }
}

otelcol.exporter.prometheus "grafana_cloud" {
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]
}

prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = env("PROMETHEUS_REMOTE_WRITE_URL")
    basic_auth {
      username = env("GRAFANA_CLOUD_USER")
      password = env("GRAFANA_CLOUD_API_KEY")
    }
  }
}

otelcol.exporter.loki "grafana_cloud" {
  forward_to = [loki.write.grafana_cloud.receiver]
}

loki.write "grafana_cloud" {
  endpoint {
    url = env("LOKI_PUSH_URL")
    basic_auth {
      username = env("GRAFANA_CLOUD_USER")
      password = env("GRAFANA_CLOUD_API_KEY")
    }
  }
}


// Probe the deployed RyanAI HTTP surfaces without requiring application credentials.
// The awareness route may remain unhealthy until its separately approved DB migration.
prometheus.exporter.blackbox "ryanai_endpoint_probes" {
  config = <<-EOT
    modules:
      http_2xx:
        prober: http
        timeout: 8s
        http:
          method: GET
          valid_status_codes: [200]
          fail_if_ssl_not_valid: true
  EOT

  target {
    name    = "ryanai-api-health"
    address = "https://ryanai-api.onrender.com/health"
    module  = "http_2xx"
  }

  target {
    name    = "ryanai-api-awareness"
    address = "https://ryanai-api.onrender.com/api/agent/ops/awareness"
    module  = "http_2xx"
  }

  target {
    name    = "ryanai-web"
    address = "https://ryanai-web.onrender.com/"
    module  = "http_2xx"
  }
}

discovery.relabel "ryanai_endpoint_probes" {
  targets = prometheus.exporter.blackbox.ryanai_endpoint_probes.targets

  rule {
    source_labels = ["__param_target"]
    target_label  = "instance"
  }
}

prometheus.scrape "ryanai_endpoint_probes" {
  targets         = discovery.relabel.ryanai_endpoint_probes.output
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
  scrape_interval = "30s"
  scrape_timeout  = "10s"
}
